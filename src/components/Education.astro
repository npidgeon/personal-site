---
import { education } from '../data/resume';
import TimelineItem from './ui/TimelineItem.astro';
import EntryToggle from './ui/EntryToggle.astro';
import Tag from './ui/Tag.astro';
---
        <section id="education" class="py-24 border-t border-white/5 section-animate">
          <div class="container mx-auto px-6 lg:px-12">
            <h2 class="text-3xl font-bold text-white mb-12 flex items-center gap-3">
              <span class="text-[#5865F2]">03.</span> Education & Certifications
            </h2>
            
            <div class="max-w-4xl">
              <ul class="timeline timeline-snap-icon timeline-compact timeline-vertical">
                {education.map((item, i) => {
                  const titleColor = item.recent ? 'text-white' : 'text-white/90';
                  const subtitle = item.credentialId ? `Credential ID: ${item.credentialId}` : item.issuer;
                  return (
                    <TimelineItem first={i === 0} last={i === education.length - 1}>
                      <time class={item.recent ? 'font-mono text-sm text-[#5865F2] bg-[#5865F2]/10 px-2 py-1 rounded' : 'font-mono text-sm text-white/50'}>{item.dates}</time>
                      {item.bullets ? (
                        <>
                          <div class="flex items-center gap-2 mt-2">
                            <h3 class={`text-xl font-bold ${titleColor}`}>{item.title}</h3>
                            <EntryToggle />
                          </div>
                          <div class="text-white/60 text-sm mb-3">{subtitle}</div>
                          <div class="entry-body">
                            <ul class="text-white/60 leading-relaxed mb-4 list-disc list-outside ml-4 space-y-1">
                              {item.bullets.map((b) => <li>{b}</li>)}
                            </ul>
                          </div>
                        </>
                      ) : (
                        <>
                          <h3 class={`text-xl font-bold ${titleColor} mt-2`}>{item.title}</h3>
                          <div class="text-white/60 text-sm mb-4">{subtitle}</div>
                        </>
                      )}
                      {item.tags && (
                        <div class="flex flex-wrap gap-2 mt-4">
                          {item.tags.map((t) => <Tag {...t} />)}
                        </div>
                      )}
                    </TimelineItem>
                  );
                })}
              </ul>
            </div>
          </div>
        </section>
