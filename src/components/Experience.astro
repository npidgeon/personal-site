---
import { experience } from '../data/resume';
import TimelineItem from './ui/TimelineItem.astro';
import EntryToggle from './ui/EntryToggle.astro';
import Tag from './ui/Tag.astro';
---
        <section id="resume" class="py-24 bg-[#2B2D31]/30 border-y border-white/5 section-animate">
          <div class="container mx-auto px-6 lg:px-12">
            <h2 class="text-3xl font-bold text-white mb-12 flex items-center gap-3">
              <span class="text-[#5865F2]">01.</span> Experience
            </h2>
            
            <div class="max-w-4xl">
              <ul class="timeline timeline-snap-icon timeline-compact timeline-vertical">
                {experience.map((job, i) => {
                  const current = i === 0;
                  return (
                    <TimelineItem first={i === 0} last={i === experience.length - 1}>
                      <time class={current ? 'font-mono text-sm text-[#5865F2] bg-[#5865F2]/10 px-2 py-1 rounded' : 'font-mono text-sm text-white/50'}>{job.dates} ({job.mode})</time>
                      <div class="flex items-center gap-2 mt-2">
                        <h3 class={`text-xl font-bold ${current ? 'text-white' : 'text-white/90'}`}>{job.title}</h3>
                        <EntryToggle expanded={current} />
                      </div>
                      <div class="text-white/60 text-sm mb-3">{job.org}</div>
                      <div class="entry-body">
                        <ul class={`${current ? 'text-white/70' : 'text-white/60'} leading-relaxed mb-4 list-disc list-outside ml-4 space-y-1`}>
                          {job.bullets.map((b) => <li>{b}</li>)}
                        </ul>
                      </div>
                      <div class="flex flex-wrap gap-2">
                        {job.tags.map((t) => <Tag name={t} />)}
                      </div>
                    </TimelineItem>
                  );
                })}
              </ul>
            </div>
          </div>
        </section>
