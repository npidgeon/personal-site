---
// Non-destructive preview: Flow Builder widget next to the Terminal for comparison.
// Visit /flow-preview during dev. Delete this file once a decision is made.
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import FlowBuilder from '../components/FlowBuilder.astro';
---

<Layout>
  <main class="container mx-auto px-6 lg:px-12 py-16">
    <h1 class="text-3xl font-bold text-white mb-2">Widget Prototype — Flow Builder</h1>
    <p class="text-white/50 mb-12 max-w-2xl">
      Side-by-side with the Terminal to stress-test recognizability, the 2-way branch at the
      narrow hero width, and theme fit. Try <span class="text-[#00E5FF]">Debug ▶</span>, switch the
      scenario chip, and use the zoom/fit controls.
    </p>

    <div class="flex flex-col xl:flex-row gap-14 items-start">
      <div>
        <h2 class="text-sm uppercase tracking-widest text-white/40 mb-4">Flow Builder (new)</h2>
        <FlowBuilder />
      </div>
      <div>
        <h2 class="text-sm uppercase tracking-widest text-white/40 mb-4">Terminal (current)</h2>
        <Terminal />
      </div>
    </div>
  </main>
</Layout>
